# Copy to .env and fill in from the Twilio Console. Never commit .env.
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN=your_auth_token
# Verify > Services > your service > Service SID
VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Demo login (no text sent) for Apple review and class testers. Leave blank to turn off.
# DEMO_PHONE must be E.164 (+1 and 10 digits). Use a 555 number nobody owns.
DEMO_PHONE=+15555550100
DEMO_CODE=
